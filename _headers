# 安全响应头（CF Pages 消费，不对外提供）
/*
	Strict-Transport-Security: max-age=31536000; includeSubDomains
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
	Permissions-Policy: geolocation=(), microphone=(), camera=(self)
	Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss: data: blob:; frame-src 'self' https:; worker-src 'self' blob:; media-src 'self' blob: https:; manifest-src 'self'

# StreamPlay intentionally supports third-party iframe embeds; do not add X-Frame-Options or frame-ancestors.
# Static JS long cache（2026-10-23 加）：引用侧一律带 ?v=<内容哈希前8位>，
# 内容变 → URL 变 → 缓存键变，所以 immutable 安全。改文件忘 bump 版本会被
# scripts/check-asset-versioning.mjs 判红（已接进 verify.yml）。
/js/*.js
	Cache-Control: public, max-age=31536000, immutable

/libs/*.js
	Cache-Control: public, max-age=31536000, immutable
